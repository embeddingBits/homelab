# Copy to .env and fill in the values. .env is gitignored.
#
# Read-only Immich API key ("Server statistics" permission), used by the
# Immich widget: Immich -> Account Settings -> API Keys -> Create.
HOMEPAGE_VAR_IMMICH_KEY=

# Host headers the dashboard may be opened under (host:port, comma separated).
HOMEPAGE_ALLOWED_HOSTS=localhost:3000

# Host paths mounted into the container.
HOMEPAGE_CONFIG_DIR=../../data/homepage/config
HOMEPAGE_MEDIA_DIR=/path/to/media

# Rootless Podman Docker-compatible API socket. 1000 is the default uid.
PODMAN_SOCKET=${PODMAN_SOCKET}
TZ_FILE=/etc/localtime
